# claude-poke optional environment overrides.
# You normally DON'T need this file — `npx github:HKTITAN/claude-poke` saves everything to
# ~/.claude-poke/config.json. These env vars override the saved config if set.

# OPTIONAL bearer token. Empty by default: the local `poke tunnel` flow can't send one, so the
# boundary is the tunnel + 127.0.0.1 bind. Only set this for a REMOTE deployment you register with
# `poke mcp add <https-url> -k <secret>` — then the server enforces Authorization: Bearer.
CLAUDE_POKE_SECRET=

# Port the local bridge listens on (default 4517).
PORT=

# OPTIONAL Poke V2 API key (poke.com/kitchen → API Keys). Enables proactive texts when a
# session finishes or needs input. Without it, the bridge still works; Poke just polls.
POKE_API_KEY=

# NOTE: No Anthropic API key is needed — claude-poke uses the Claude Code login already on this
# machine (your claude.ai subscription). ANTHROPIC_API_KEY is honored only if you choose to set it.
